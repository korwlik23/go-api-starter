# Default local profile: PostgreSQL

# Application
APP_ENV=development
APP_NAME=go-api-starter
HTTP_ADDRESS=127.0.0.1:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=debug
LOG_FORMAT=json

# Browser origins and proxy trust
PUBLIC_ORIGIN=http://localhost:4321
ADMIN_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXY_CIDRS=

# Session and authentication
SESSION_STORE=database
SESSION_COOKIE_NAME=go_lang_starter_session
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h
SESSION_TOKEN_PEPPER=development-only-session-token-pepper-not-for-production
CSRF_TOKEN_PEPPER=development-only-csrf-token-pepper-not-for-production
TOTP_ENCRYPTION_KEY_B64=ERERERERERERERERERERERERERERERERERERERERERE=
AUTH_ATTEMPT_THRESHOLD=5
AUTH_ATTEMPT_WINDOW=15m
AUTH_ATTEMPT_LOCK_DURATION=30m
AUTH_ATTEMPT_CLEANUP_BATCH=500
AUTH_ATTEMPT_FINGERPRINT_KEY=development-only-auth-attempt-fingerprint-key-not-for-production

# Database
DB_DRIVER=postgres
DB_FLAVOR=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=go_lang_starter_dev
DB_USER=go_lang_starter
DB_PASSWORD=development-only-database-password
DB_TLS_MODE=disable
DB_TIME_ZONE=UTC
DB_CONNECT_TIMEOUT=5s
DB_MIGRATION_LOCK_TIMEOUT=2m
DB_MAX_OPEN_CONNECTIONS=20
DB_MAX_IDLE_CONNECTIONS=5
DB_CONNECTION_MAX_LIFETIME=30m

# Localization
INITIAL_LOCALES=th,en
DEFAULT_LOCALE=th

# Per-instance rate limits
RATE_LIMIT_BASELINE_CAPACITY=120
RATE_LIMIT_BASELINE_WINDOW=1m
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_LOGIN_WINDOW=1m
RATE_LIMIT_RECOVERY_CAPACITY=3
RATE_LIMIT_RECOVERY_WINDOW=15m
RATE_LIMIT_MFA_CAPACITY=5
RATE_LIMIT_MFA_WINDOW=5m

# Optional Redis capability
REDIS_ENABLED=false
REDIS_ADDRESS=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DATABASE=0
